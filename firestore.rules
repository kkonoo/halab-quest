rules_version = '2';
// Firebase 프로젝트 lab-manager-knumed 의 규칙 전체예요. Lab Manager 부분 + HaLab Quest 부분(맨 아래 quest)이 같이 들어 있어요.
// Firebase 콘솔 > Firestore Database > 규칙 에 이 파일 내용을 통째로 붙여 넣어요. (Lab Manager 저장소의 firestore.rules도 같은 내용으로 맞춰 두기)
// ── Lab Manager ──
// users/{uid}/**  : PI 본인만 (과제·인건비·세목·정보·서류·내 정보)
// labs/{PI uid}   : 랩 문서 { owner, ownerEmail, ownerName, members: [학생 구글 이메일(소문자)] } — PI만 고침
// labs/{PI uid}/**: 프로토콜·재고(묶음·위치·업체·품목·주문) — PI와 멤버가 읽고 씀
// calcPresets/{PI uid}: 실험 계산기 버퍼 프리셋 { j } — 누구나 읽음(수업 학생은 로그인 없이 calc.html?lab=), PI만 고침
// ── HaLab Quest ──
// quest/{email}/** : 학생 본인(구글 이메일 = 문서 이름)만 읽고 씀. 그 학생이 멤버로 들어 있는 랩의 PI는 읽기만
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.email; }
    function verified() { return request.auth.token.email_verified == true; }

    match /users/{uid}/{rest=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /labs/{labId} {
      function isOwner() { return signedIn() && request.auth.uid == labId; }
      function isMember() {
        return signedIn() && verified() && myEmail() in get(/databases/$(database)/documents/labs/$(labId)).data.members;
      }
      // 랩 문서: PI는 읽고 씀, 멤버는 읽기만 (학생이 '내 랩' 찾기: members array-contains 내 이메일)
      allow read: if isOwner() || (signedIn() && verified() && myEmail() in resource.data.members);
      allow create, update: if isOwner() && request.resource.data.owner == request.auth.uid;
      allow delete: if isOwner();

      match /{rest=**} {
        allow read, write: if isOwner() || isMember();
      }
    }

    match /calcPresets/{uid} {
      allow get: if true; // 문서 하나만 (목록 훑기는 안 됨)
      allow write: if signedIn() && request.auth.uid == uid;
    }

    match /quest/{email} {
      function isMe() { return signedIn() && verified() && myEmail().lower() == email; }
      function isMyPI() {
        return signedIn() && exists(/databases/$(database)/documents/labs/$(request.auth.uid))
          && email in get(/databases/$(database)/documents/labs/$(request.auth.uid)).data.members;
      }
      allow read: if isMe() || isMyPI();
      allow write: if isMe();

      match /{rest=**} {
        allow read: if isMe() || isMyPI();
        allow write: if isMe();
      }
    }
  }
}
